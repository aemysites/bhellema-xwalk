<p class="p2"><span class="Apple-converted-space">     </span>/**</p>
<p class="p2"><span class="Apple-converted-space">      </span>* Parser for carousel-hero block variant</p>
<p class="p2"><span class="Apple-converted-space">      </span>* Converts source HTML carousel/hero elements into AEM block table format</p>
<p class="p2"><span class="Apple-converted-space">      </span>*/</p>
<p class="p2"><span class="Apple-converted-space">     </span>export default function parse(element, { document }) {</p>
<p class="p2"><span class="Apple-converted-space">       </span>const rows = [];</p>
<p class="p1"><br></p>
<p class="p2"><span class="Apple-converted-space">       </span>// Find all slides in the carousel</p>
<p class="p2"><span class="Apple-converted-space">       </span>const slides = element.querySelectorAll('.slide, .carousel-item, [class*="slide"]');</p>
<p class="p1"><br></p>
<p class="p2"><span class="Apple-converted-space">       </span>slides.forEach((slide) =&gt; {</p>
<p class="p2"><span class="Apple-converted-space">         </span>const row = [];</p>
<p class="p1"><br></p>
<p class="p2"><span class="Apple-converted-space">         </span>// Column 1: Image</p>
<p class="p2"><span class="Apple-converted-space">         </span>const img = slide.querySelector('img');</p>
<p class="p2"><span class="Apple-converted-space">         </span>if (img) {</p>
<p class="p2"><span class="Apple-converted-space">           </span>const picture = document.createElement('picture');</p>
<p class="p2"><span class="Apple-converted-space">           </span>const imgClone = img.cloneNode(true);</p>
<p class="p2"><span class="Apple-converted-space">           </span>picture.appendChild(imgClone);</p>
<p class="p2"><span class="Apple-converted-space">           </span>row.push(picture);</p>
<p class="p2"><span class="Apple-converted-space">         </span>} else {</p>
<p class="p2"><span class="Apple-converted-space">           </span>row.push('');</p>
<p class="p2"><span class="Apple-converted-space">         </span>}</p>
<p class="p1"><br></p>
<p class="p2"><span class="Apple-converted-space">         </span>// Column 2: Text content (heading, description, CTA)</p>
<p class="p2"><span class="Apple-converted-space">         </span>const textContent = document.createElement('div');</p>
<p class="p1"><br></p>
<p class="p2"><span class="Apple-converted-space">         </span>const heading = slide.querySelector('h1, h2, h3, .title, .heading');</p>
<p class="p2"><span class="Apple-converted-space">         </span>if (heading) {</p>
<p class="p2"><span class="Apple-converted-space">           </span>const h2 = document.createElement('h2');</p>
<p class="p2"><span class="Apple-converted-space">           </span>h2.textContent = heading.textContent.trim();</p>
<p class="p2"><span class="Apple-converted-space">           </span>textContent.appendChild(h2);</p>
<p class="p2"><span class="Apple-converted-space">         </span>}</p>
<p class="p1"><br></p>
<p class="p2"><span class="Apple-converted-space">         </span>const description = slide.querySelector('p, .description, .text');</p>
<p class="p2"><span class="Apple-converted-space">         </span>if (description) {</p>
<p class="p2"><span class="Apple-converted-space">           </span>const p = document.createElement('p');</p>
<p class="p2"><span class="Apple-converted-space">           </span>p.textContent = description.textContent.trim();</p>
<p class="p2"><span class="Apple-converted-space">           </span>textContent.appendChild(p);</p>
<p class="p2"><span class="Apple-converted-space">         </span>}</p>
<p class="p1"><br></p>
<p class="p2"><span class="Apple-converted-space">         </span>const cta = slide.querySelector('a.cta, a.button, a[href]');</p>
<p class="p2"><span class="Apple-converted-space">         </span>if (cta) {</p>
<p class="p2"><span class="Apple-converted-space">           </span>const p = document.createElement('p');</p>
<p class="p2"><span class="Apple-converted-space">           </span>const strong = document.createElement('strong');</p>
<p class="p2"><span class="Apple-converted-space">           </span>const link = document.createElement('a');</p>
<p class="p2"><span class="Apple-converted-space">           </span>link.href = cta.href;</p>
<p class="p2"><span class="Apple-converted-space">           </span>link.textContent = cta.textContent.trim();</p>
<p class="p2"><span class="Apple-converted-space">           </span>strong.appendChild(link);</p>
<p class="p2"><span class="Apple-converted-space">           </span>p.appendChild(strong);</p>
<p class="p2"><span class="Apple-converted-space">           </span>textContent.appendChild(p);</p>
<p class="p2"><span class="Apple-converted-space">         </span>}</p>
<p class="p1"><br></p>
<p class="p2"><span class="Apple-converted-space">         </span>row.push(textContent);</p>
<p class="p2"><span class="Apple-converted-space">         </span>rows.push(row);</p>
<p class="p2"><span class="Apple-converted-space">       </span>});</p>
<p class="p1"><br></p>
<p class="p2"><span class="Apple-converted-space">       </span>return rows;</p>
<p class="p2"><span class="Apple-converted-space">     </span>}</p>
