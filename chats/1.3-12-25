<p class="p2"><span class="Apple-converted-space">     </span>import { createOptimizedPicture } from '../../scripts/aem.js';</p>
<p class="p2"><span class="Apple-converted-space">     </span>import { moveInstrumentation } from '../../scripts/scripts.js';</p>
<p class="p1"><br></p>
<p class="p2"><span class="Apple-converted-space">     </span>export default function decorate(block) {</p>
<p class="p2"><span class="Apple-converted-space">       </span>/* change to ul, li */</p>
<p class="p2"><span class="Apple-converted-space">       </span>const ul = document.createElement('ul');</p>
<p class="p2"><span class="Apple-converted-space">       </span>[...block.children].forEach((row) =&gt; {</p>
<p class="p2"><span class="Apple-converted-space">         </span>const li = document.createElement('li');</p>
<p class="p2"><span class="Apple-converted-space">         </span>moveInstrumentation(row, li);</p>
<p class="p2"><span class="Apple-converted-space">         </span>while (row.firstElementChild) li.append(row.firstElementChild);</p>
<p class="p2"><span class="Apple-converted-space">         </span>[...li.children].forEach((div) =&gt; {</p>
<p class="p2"><span class="Apple-converted-space">           </span>if (div.children.length === 1 &amp;&amp; div.querySelector('picture')) div.className = 'cards-promo-card-image';</p>
<p class="p2"><span class="Apple-converted-space">           </span>else div.className = 'cards-promo-card-body';</p>
<p class="p2"><span class="Apple-converted-space">         </span>});</p>
<p class="p2"><span class="Apple-converted-space">         </span>ul.append(li);</p>
<p class="p2"><span class="Apple-converted-space">       </span>});</p>
<p class="p2"><span class="Apple-converted-space">       </span>ul.querySelectorAll('picture &gt; img').forEach((img) =&gt; {</p>
<p class="p2"><span class="Apple-converted-space">         </span>const optimizedPic = createOptimizedPicture(img.src, img.alt, false, [{ width: '750' }]);</p>
<p class="p2"><span class="Apple-converted-space">         </span>moveInstrumentation(img, optimizedPic.querySelector('img'));</p>
<p class="p2"><span class="Apple-converted-space">         </span>img.closest('picture').replaceWith(optimizedPic);</p>
<p class="p2"><span class="Apple-converted-space">       </span>});</p>
<p class="p2"><span class="Apple-converted-space">       </span>block.textContent = '';</p>
<p class="p2"><span class="Apple-converted-space">       </span>block.append(ul);</p>
<p class="p2"><span class="Apple-converted-space">     </span>}</p>
