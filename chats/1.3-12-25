<p class="p2"><span class="Apple-converted-space">     </span>// Block parsers</p>
<p class="p2"><span class="Apple-converted-space">     </span>import carouselHeroParser from './parsers/carousel-hero.js';</p>
<p class="p2"><span class="Apple-converted-space">     </span>import heroVideoParser from './parsers/hero-video.js';</p>
<p class="p2"><span class="Apple-converted-space">     </span>import cardsPromoParser from './parsers/cards-promo.js';</p>
<p class="p2"><span class="Apple-converted-space">     </span>import columnsBannerParser from './parsers/columns-banner.js';</p>
<p class="p1"><br></p>
<p class="p2"><span class="Apple-converted-space">     </span>// Page templates configuration</p>
<p class="p2"><span class="Apple-converted-space">     </span>import pageTemplates from './page-templates.json' with { type: 'json' };</p>
<p class="p1"><br></p>
<p class="p2"><span class="Apple-converted-space">     </span>/**</p>
<p class="p2"><span class="Apple-converted-space">      </span>* Block parser registry - maps block names to their parser functions</p>
<p class="p2"><span class="Apple-converted-space">      </span>*/</p>
<p class="p2"><span class="Apple-converted-space">     </span>const blockParsers = {</p>
<p class="p2"><span class="Apple-converted-space">       </span>'carousel-hero': carouselHeroParser,</p>
<p class="p2"><span class="Apple-converted-space">       </span>'hero-video': heroVideoParser,</p>
<p class="p2"><span class="Apple-converted-space">       </span>'cards-promo': cardsPromoParser,</p>
<p class="p2"><span class="Apple-converted-space">       </span>'columns-banner': columnsBannerParser,</p>
<p class="p2"><span class="Apple-converted-space">     </span>};</p>
<p class="p1"><br></p>
<p class="p2"><span class="Apple-converted-space">     </span>/**</p>
<p class="p2"><span class="Apple-converted-space">      </span>* Creates an AEM block table element</p>
<p class="p2"><span class="Apple-converted-space">      </span>* @param {Document} document - The document object</p>
<p class="p2"><span class="Apple-converted-space">      </span>* @param {string} blockName - The name of the block</p>
<p class="p2"><span class="Apple-converted-space">      </span>* @param {Array} rows - Array of rows, each row is an array of cells</p>
<p class="p2"><span class="Apple-converted-space">      </span>* @returns {HTMLElement} - The block table element</p>
<p class="p2"><span class="Apple-converted-space">      </span>*/</p>
<p class="p2"><span class="Apple-converted-space">     </span>function createBlockTable(document, blockName, rows) {</p>
<p class="p2"><span class="Apple-converted-space">       </span>const table = document.createElement('table');</p>
<p class="p1"><br></p>
<p class="p2"><span class="Apple-converted-space">       </span>// Header row with block name</p>
<p class="p2"><span class="Apple-converted-space">       </span>const headerRow = document.createElement('tr');</p>
<p class="p2"><span class="Apple-converted-space">       </span>const headerCell = document.createElement('th');</p>
<p class="p2"><span class="Apple-converted-space">       </span>headerCell.textContent = blockName;</p>
<p class="p2"><span class="Apple-converted-space">       </span>headerCell.colSpan = rows[0]?.length || 1;</p>
<p class="p2"><span class="Apple-converted-space">       </span>headerRow.appendChild(headerCell);</p>
<p class="p2"><span class="Apple-converted-space">       </span>table.appendChild(headerRow);</p>
<p class="p1"><br></p>
<p class="p2"><span class="Apple-converted-space">       </span>// Content rows</p>
<p class="p2"><span class="Apple-converted-space">       </span>rows.forEach((row) =&gt; {</p>
<p class="p2"><span class="Apple-converted-space">         </span>const tr = document.createElement('tr');</p>
<p class="p2"><span class="Apple-converted-space">         </span>row.forEach((cell) =&gt; {</p>
<p class="p2"><span class="Apple-converted-space">           </span>const td = document.createElement('td');</p>
<p class="p2"><span class="Apple-converted-space">           </span>if (typeof cell === 'string') {</p>
<p class="p2"><span class="Apple-converted-space">             </span>td.textContent = cell;</p>
<p class="p2"><span class="Apple-converted-space">           </span>} else if (cell instanceof Element) {</p>
<p class="p2"><span class="Apple-converted-space">             </span>td.appendChild(cell);</p>
<p class="p2"><span class="Apple-converted-space">           </span>}</p>
<p class="p2"><span class="Apple-converted-space">           </span>tr.appendChild(td);</p>
<p class="p2"><span class="Apple-converted-space">         </span>});</p>
<p class="p2"><span class="Apple-converted-space">         </span>table.appendChild(tr);</p>
<p class="p2"><span class="Apple-converted-space">       </span>});</p>
<p class="p1"><br></p>
<p class="p2"><span class="Apple-converted-space">       </span>return table;</p>
<p class="p2"><span class="Apple-converted-space">     </span>}</p>
<p class="p1"><br></p>
<p class="p2"><span class="Apple-converted-space">     </span>/**</p>
<p class="p2"><span class="Apple-converted-space">      </span>* Detects which template applies to a given URL</p>
<p class="p2"><span class="Apple-converted-space">      </span>* @param {string} url - The page URL</p>
<p class="p2"><span class="Apple-converted-space">      </span>* @returns {Object|null} - The matching template or null</p>
<p class="p2"><span class="Apple-converted-space">      </span>*/</p>
<p class="p2"><span class="Apple-converted-space">     </span>function detectTemplate(url) {</p>
<p class="p2"><span class="Apple-converted-space">       </span>for (const template of pageTemplates.templates) {</p>
<p class="p2"><span class="Apple-converted-space">         </span>if (template.urls.some((templateUrl) =&gt; url.includes(templateUrl) || templateUrl.includes(url))) {</p>
<p class="p2"><span class="Apple-converted-space">           </span>return template;</p>
<p class="p2"><span class="Apple-converted-space">         </span>}</p>
<p class="p2"><span class="Apple-converted-space">       </span>}</p>
<p class="p2"><span class="Apple-converted-space">       </span>return null;</p>
<p class="p2"><span class="Apple-converted-space">     </span>}</p>
<p class="p1"><br></p>
<p class="p2"><span class="Apple-converted-space">     </span>/**</p>
<p class="p2"><span class="Apple-converted-space">      </span>* Finds and parses blocks in the document based on template configuration</p>
<p class="p2"><span class="Apple-converted-space">      </span>* @param {Document} document - The document object</p>
<p class="p2"><span class="Apple-converted-space">      </span>* @param {Object} template - The template configuration</p>
<p class="p2"><span class="Apple-converted-space">      </span>* @returns {Array} - Array of { element, blockName, blockTable } objects</p>
<p class="p2"><span class="Apple-converted-space">      </span>*/</p>
<p class="p2"><span class="Apple-converted-space">     </span>function findAndParseBlocks(document, template) {</p>
<p class="p2"><span class="Apple-converted-space">       </span>const results = [];</p>
<p class="p1"><br></p>
<p class="p2"><span class="Apple-converted-space">       </span>if (!template || !template.blocks) {</p>
<p class="p2"><span class="Apple-converted-space">         </span>return results;</p>
<p class="p2"><span class="Apple-converted-space">       </span>}</p>
<p class="p1"><br></p>
<p class="p2"><span class="Apple-converted-space">       </span>template.blocks.forEach((blockConfig) =&gt; {</p>
<p class="p2"><span class="Apple-converted-space">         </span>const { name, instances } = blockConfig;</p>
<p class="p2"><span class="Apple-converted-space">         </span>const parser = blockParsers[name];</p>
<p class="p1"><br></p>
<p class="p2"><span class="Apple-converted-space">         </span>if (!parser) {</p>
<p class="p2"><span class="Apple-converted-space">           </span>console.warn(`No parser found for block: ${name}`);</p>
<p class="p2"><span class="Apple-converted-space">           </span>return;</p>
<p class="p2"><span class="Apple-converted-space">         </span>}</p>
<p class="p1"><br></p>
<p class="p2"><span class="Apple-converted-space">         </span>// Find all instances of this block</p>
<p class="p2"><span class="Apple-converted-space">         </span>instances.forEach((selector) =&gt; {</p>
<p class="p2"><span class="Apple-converted-space">           </span>const elements = document.querySelectorAll(selector);</p>
<p class="p2"><span class="Apple-converted-space">           </span>elements.forEach((element) =&gt; {</p>
<p class="p2"><span class="Apple-converted-space">             </span>try {</p>
<p class="p2"><span class="Apple-converted-space">               </span>const rows = parser(element, { document });</p>
<p class="p2"><span class="Apple-converted-space">               </span>if (rows &amp;&amp; rows.length &gt; 0) {</p>
<p class="p2"><span class="Apple-converted-space">                 </span>const blockTable = createBlockTable(document, name, rows);</p>
<p class="p2"><span class="Apple-converted-space">                 </span>results.push({</p>
<p class="p2"><span class="Apple-converted-space">                   </span>element,</p>
<p class="p2"><span class="Apple-converted-space">                   </span>blockName: name,</p>
<p class="p2"><span class="Apple-converted-space">                   </span>blockTable,</p>
<p class="p2"><span class="Apple-converted-space">                 </span>});</p>
<p class="p2"><span class="Apple-converted-space">               </span>}</p>
<p class="p2"><span class="Apple-converted-space">             </span>} catch (error) {</p>
<p class="p2"><span class="Apple-converted-space">               </span>console.error(`Error parsing block ${name}:`, error);</p>
<p class="p2"><span class="Apple-converted-space">             </span>}</p>
<p class="p2"><span class="Apple-converted-space">           </span>});</p>
<p class="p2"><span class="Apple-converted-space">         </span>});</p>
<p class="p2"><span class="Apple-converted-space">       </span>});</p>
<p class="p1"><br></p>
<p class="p2"><span class="Apple-converted-space">       </span>return results;</p>
<p class="p2"><span class="Apple-converted-space">     </span>}</p>
<p class="p1"><br></p>
<p class="p2"><span class="Apple-converted-space">     </span>/**</p>
<p class="p2"><span class="Apple-converted-space">      </span>* Extracts page metadata from the document</p>
<p class="p2"><span class="Apple-converted-space">      </span>* @param {Document} document - The document object</p>
<p class="p2"><span class="Apple-converted-space">      </span>* @returns {Object} - Metadata key-value pairs</p>
<p class="p2"><span class="Apple-converted-space">      </span>*/</p>
<p class="p2"><span class="Apple-converted-space">     </span>function extractMetadata(document) {</p>
<p class="p2"><span class="Apple-converted-space">       </span>const metadata = {};</p>
<p class="p1"><br></p>
<p class="p2"><span class="Apple-converted-space">       </span>// Title</p>
<p class="p2"><span class="Apple-converted-space">       </span>const title = document.querySelector('title');</p>
<p class="p2"><span class="Apple-converted-space">       </span>if (title) {</p>
<p class="p2"><span class="Apple-converted-space">         </span>metadata.Title = title.textContent.trim();</p>
<p class="p2"><span class="Apple-converted-space">       </span>}</p>
<p class="p1"><br></p>
<p class="p2"><span class="Apple-converted-space">       </span>// Meta tags</p>
<p class="p2"><span class="Apple-converted-space">       </span>const metaTags = document.querySelectorAll('meta[name], meta[property]');</p>
<p class="p2"><span class="Apple-converted-space">       </span>metaTags.forEach((meta) =&gt; {</p>
<p class="p2"><span class="Apple-converted-space">         </span>const name = meta.getAttribute('name') || meta.getAttribute('property');</p>
<p class="p2"><span class="Apple-converted-space">         </span>const content = meta.getAttribute('content');</p>
<p class="p2"><span class="Apple-converted-space">         </span>if (name &amp;&amp; content) {</p>
<p class="p2"><span class="Apple-converted-space">           </span>// Convert og:title to Title, og:description to Description, etc.</p>
<p class="p2"><span class="Apple-converted-space">           </span>const key = name</p>
<p class="p2"><span class="Apple-converted-space">             </span>.replace(/^og:/, '')</p>
<p class="p2"><span class="Apple-converted-space">             </span>.replace(/^twitter:/, '')</p>
<p class="p2"><span class="Apple-converted-space">             </span>.replace(/[-_]/g, ' ')</p>
<p class="p2"><span class="Apple-converted-space">             </span>.split(' ')</p>
<p class="p2"><span class="Apple-converted-space">             </span>.map((word) =&gt; word.charAt(0).toUpperCase() + word.slice(1))</p>
<p class="p2"><span class="Apple-converted-space">             </span>.join(' ');</p>
<p class="p2"><span class="Apple-converted-space">           </span>if (!metadata[key]) {</p>
<p class="p2"><span class="Apple-converted-space">             </span>metadata[key] = content;</p>
<p class="p2"><span class="Apple-converted-space">           </span>}</p>
<p class="p2"><span class="Apple-converted-space">         </span>}</p>
<p class="p2"><span class="Apple-converted-space">       </span>});</p>
<p class="p1"><br></p>
<p class="p2"><span class="Apple-converted-space">       </span>return metadata;</p>
<p class="p2"><span class="Apple-converted-space">     </span>}</p>
<p class="p1"><br></p>
<p class="p2"><span class="Apple-converted-space">     </span>/**</p>
<p class="p2"><span class="Apple-converted-space">      </span>* Creates a metadata block table</p>
<p class="p2"><span class="Apple-converted-space">      </span>* @param {Document} document - The document object</p>
<p class="p2"><span class="Apple-converted-space">      </span>* @param {Object} metadata - Metadata key-value pairs</p>
<p class="p2"><span class="Apple-converted-space">      </span>* @returns {HTMLElement} - The metadata table element</p>
<p class="p2"><span class="Apple-converted-space">      </span>*/</p>
<p class="p2"><span class="Apple-converted-space">     </span>function createMetadataTable(document, metadata) {</p>
<p class="p2"><span class="Apple-converted-space">       </span>const table = document.createElement('table');</p>
<p class="p1"><br></p>
<p class="p2"><span class="Apple-converted-space">       </span>// Header row</p>
<p class="p2"><span class="Apple-converted-space">       </span>const headerRow = document.createElement('tr');</p>
<p class="p2"><span class="Apple-converted-space">       </span>const headerCell = document.createElement('th');</p>
<p class="p2"><span class="Apple-converted-space">       </span>headerCell.textContent = 'Metadata';</p>
<p class="p2"><span class="Apple-converted-space">       </span>headerCell.colSpan = 2;</p>
<p class="p2"><span class="Apple-converted-space">       </span>headerRow.appendChild(headerCell);</p>
<p class="p2"><span class="Apple-converted-space">       </span>table.appendChild(headerRow);</p>
<p class="p1"><br></p>
<p class="p2"><span class="Apple-converted-space">       </span>// Metadata rows</p>
<p class="p2"><span class="Apple-converted-space">       </span>Object.entries(metadata).forEach(([key, value]) =&gt; {</p>
<p class="p2"><span class="Apple-converted-space">         </span>const tr = document.createElement('tr');</p>
<p class="p2"><span class="Apple-converted-space">         </span>const keyCell = document.createElement('td');</p>
<p class="p2"><span class="Apple-converted-space">         </span>keyCell.textContent = key;</p>
<p class="p2"><span class="Apple-converted-space">         </span>const valueCell = document.createElement('td');</p>
<p class="p2"><span class="Apple-converted-space">         </span>valueCell.textContent = value;</p>
<p class="p2"><span class="Apple-converted-space">         </span>tr.appendChild(keyCell);</p>
<p class="p2"><span class="Apple-converted-space">         </span>tr.appendChild(valueCell);</p>
<p class="p2"><span class="Apple-converted-space">         </span>table.appendChild(tr);</p>
<p class="p2"><span class="Apple-converted-space">       </span>});</p>
<p class="p1"><br></p>
<p class="p2"><span class="Apple-converted-space">       </span>return table;</p>
<p class="p2"><span class="Apple-converted-space">     </span>}</p>
<p class="p1"><br></p>
<p class="p2"><span class="Apple-converted-space">     </span>/**</p>
<p class="p2"><span class="Apple-converted-space">      </span>* Main transformation function - transforms the DOM for import</p>
<p class="p2"><span class="Apple-converted-space">      </span>* @param {Object} params - Transformation parameters</p>
<p class="p2"><span class="Apple-converted-space">      </span>* @param {Document} params.document - The document object</p>
<p class="p2"><span class="Apple-converted-space">      </span>* @param {string} params.url - The page URL</p>
<p class="p2"><span class="Apple-converted-space">      </span>* @param {string} params.html - The raw HTML string</p>
<p class="p2"><span class="Apple-converted-space">      </span>* @param {Object} params.params - Additional parameters</p>
<p class="p2"><span class="Apple-converted-space">      </span>* @returns {Object} - The transformation result with element and report</p>
<p class="p2"><span class="Apple-converted-space">      </span>*/</p>
<p class="p2"><span class="Apple-converted-space">     </span>export function transformDOM({ document, url, html, params }) {</p>
<p class="p2"><span class="Apple-converted-space">       </span>const main = document.body;</p>
<p class="p1"><br></p>
<p class="p2"><span class="Apple-converted-space">       </span>// Detect template for this URL</p>
<p class="p2"><span class="Apple-converted-space">       </span>const template = detectTemplate(url);</p>
<p class="p1"><br></p>
<p class="p2"><span class="Apple-converted-space">       </span>// Find and parse blocks</p>
<p class="p2"><span class="Apple-converted-space">       </span>const parsedBlocks = findAndParseBlocks(document, template);</p>
<p class="p1"><br></p>
<p class="p2"><span class="Apple-converted-space">       </span>// Replace original elements with block tables</p>
<p class="p2"><span class="Apple-converted-space">       </span>parsedBlocks.forEach(({ element, blockTable }) =&gt; {</p>
<p class="p2"><span class="Apple-converted-space">         </span>if (element.parentNode) {</p>
<p class="p2"><span class="Apple-converted-space">           </span>element.parentNode.replaceChild(blockTable, element);</p>
<p class="p2"><span class="Apple-converted-space">         </span>}</p>
<p class="p2"><span class="Apple-converted-space">       </span>});</p>
<p class="p1"><br></p>
<p class="p2"><span class="Apple-converted-space">       </span>// Clean up: remove scripts, styles, and other non-content elements</p>
<p class="p2"><span class="Apple-converted-space">       </span>const elementsToRemove = main.querySelectorAll('script, style, noscript, iframe, svg:not(picture svg)');</p>
<p class="p2"><span class="Apple-converted-space">       </span>elementsToRemove.forEach((el) =&gt; el.remove());</p>
<p class="p1"><br></p>
<p class="p2"><span class="Apple-converted-space">       </span>// Remove empty elements</p>
<p class="p2"><span class="Apple-converted-space">       </span>const emptyElements = main.querySelectorAll('div:empty, span:empty, p:empty');</p>
<p class="p2"><span class="Apple-converted-space">       </span>emptyElements.forEach((el) =&gt; {</p>
<p class="p2"><span class="Apple-converted-space">         </span>if (!el.querySelector('img, picture, video, iframe')) {</p>
<p class="p2"><span class="Apple-converted-space">           </span>el.remove();</p>
<p class="p2"><span class="Apple-converted-space">         </span>}</p>
<p class="p2"><span class="Apple-converted-space">       </span>});</p>
<p class="p1"><br></p>
<p class="p2"><span class="Apple-converted-space">       </span>// Extract and append metadata</p>
<p class="p2"><span class="Apple-converted-space">       </span>const metadata = extractMetadata(document);</p>
<p class="p2"><span class="Apple-converted-space">       </span>if (Object.keys(metadata).length &gt; 0) {</p>
<p class="p2"><span class="Apple-converted-space">         </span>const metadataTable = createMetadataTable(document, metadata);</p>
<p class="p2"><span class="Apple-converted-space">         </span>main.appendChild(document.createElement('hr'));</p>
<p class="p2"><span class="Apple-converted-space">         </span>main.appendChild(metadataTable);</p>
<p class="p2"><span class="Apple-converted-space">       </span>}</p>
<p class="p1"><br></p>
<p class="p2"><span class="Apple-converted-space">       </span>return {</p>
<p class="p2"><span class="Apple-converted-space">         </span>element: main,</p>
<p class="p2"><span class="Apple-converted-space">         </span>report: {</p>
<p class="p2"><span class="Apple-converted-space">           </span>template: template?.name || 'default',</p>
<p class="p2"><span class="Apple-converted-space">           </span>blocksFound: parsedBlocks.length,</p>
<p class="p2"><span class="Apple-converted-space">           </span>blockTypes: [...new Set(parsedBlocks.map((b) =&gt; b.blockName))],</p>
<p class="p2"><span class="Apple-converted-space">         </span>},</p>
<p class="p2"><span class="Apple-converted-space">       </span>};</p>
<p class="p2"><span class="Apple-converted-space">     </span>}</p>
<p class="p1"><br></p>
<p class="p2"><span class="Apple-converted-space">     </span>/**</p>
<p class="p2"><span class="Apple-converted-space">      </span>* Generates the document path for the imported page</p>
<p class="p2"><span class="Apple-converted-space">      </span>* @param {Object} params - Parameters object</p>
<p class="p2"><span class="Apple-converted-space">      </span>* @param {Document} params.document - The document object</p>
<p class="p2"><span class="Apple-converted-space">      </span>* @param {string} params.url - The page URL</p>
<p class="p2"><span class="Apple-converted-space">      </span>* @returns {string} - The document path (without extension)</p>
<p class="p2"><span class="Apple-converted-space">      </span>*/</p>
<p class="p2"><span class="Apple-converted-space">     </span>export function generateDocumentPath({ document, url }) {</p>
<p class="p2"><span class="Apple-converted-space">       </span>let path = new URL(url).pathname;</p>
<p class="p1"><br></p>
<p class="p2"><span class="Apple-converted-space">       </span>// Remove trailing slash</p>
<p class="p2"><span class="Apple-converted-space">       </span>if (path.endsWith('/')) {</p>
<p class="p2"><span class="Apple-converted-space">         </span>path = path.slice(0, -1);</p>
<p class="p2"><span class="Apple-converted-space">       </span>}</p>
<p class="p1"><br></p>
<p class="p2"><span class="Apple-converted-space">       </span>// Handle root path</p>
<p class="p2"><span class="Apple-converted-space">       </span>if (!path || path === '') {</p>
<p class="p2"><span class="Apple-converted-space">         </span>path = '/index';</p>
<p class="p2"><span class="Apple-converted-space">       </span>}</p>
<p class="p1"><br></p>
<p class="p2"><span class="Apple-converted-space">       </span>// Remove file extension if present</p>
<p class="p2"><span class="Apple-converted-space">       </span>path = path.replace(/\.(html|htm|php|asp|aspx)$/i, '');</p>
<p class="p1"><br></p>
<p class="p2"><span class="Apple-converted-space">       </span>// Ensure path doesn't end with index for non-root pages</p>
<p class="p2"><span class="Apple-converted-space">       </span>if (path !== '/index' &amp;&amp; path.endsWith('/index')) {</p>
<p class="p2"><span class="Apple-converted-space">         </span>path = path.slice(0, -6);</p>
<p class="p2"><span class="Apple-converted-space">       </span>}</p>
<p class="p1"><br></p>
<p class="p2"><span class="Apple-converted-space">       </span>return path;</p>
<p class="p2"><span class="Apple-converted-space">     </span>}</p>
<p class="p1"><br></p>
<p class="p2"><span class="Apple-converted-space">     </span>/**</p>
<p class="p2"><span class="Apple-converted-space">      </span>* Default export for the importer</p>
<p class="p2"><span class="Apple-converted-space">      </span>*/</p>
<p class="p2"><span class="Apple-converted-space">     </span>export default {</p>
<p class="p2"><span class="Apple-converted-space">       </span>transformDOM,</p>
<p class="p2"><span class="Apple-converted-space">       </span>generateDocumentPath,</p>
<p class="p2"><span class="Apple-converted-space">       </span>blockParsers,</p>
<p class="p2"><span class="Apple-converted-space">       </span>pageTemplates,</p>
<p class="p2"><span class="Apple-converted-space">     </span>};</p>
